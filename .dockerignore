# Environment variables — never bake secrets into the image
.env
.env.*

# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Virtual environment — container installs its own from requirements.txt
venv/
.venv/
env/

# Git history — not needed inside the container
.git/
.gitignore

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
